---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
	const releases = await getCollection('releases');
	releases.sort((a, b) => +b.data.date - +a.data.date || b.id.localeCompare(a.id, undefined, { numeric: true }));

	return releases.map((release, index) => ({
		params: { slug: release.id },
		props: { release, newer: releases[index - 1], older: releases[index + 1], latest: index === 0 },
	}));
}

const { release, newer, older, latest } = Astro.props;

const { Content } = await render(release);
---

<Layout {release} {newer} {older} {latest}>
	<Content />
</Layout>
