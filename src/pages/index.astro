---
import { getCollection, render } from 'astro:content';
import { ShieldCheck } from '@lucide/astro';
import Release from '../components/Release.astro';
import Layout from '../layouts/IndexLayout.astro';

const posts = await getCollection('releases');
posts.sort((a, b) => +b.data.date - +a.data.date || b.id.localeCompare(a.id, undefined, { numeric: true }));
const issues = await Promise.all(posts.map(async (post) => ({ post, Content: (await render(post)).Content })));
const shortDate = (date: Date) => `${String(date.getUTCDate()).padStart(2, '0')}.${String(date.getUTCMonth() + 1).padStart(2, '0')}.`;
---

<Layout
	title="Pitaj.io Novosti · Zabilješke o izdanjima i novim funkcijama"
	description="Sve najnovije nadogradnje, poboljšanja i nove mogućnosti na Pitaj.io platformi za kreiranje inteligentnih AI agenata."
>
	<main id="main-content" class="page program">
		<aside class="rail" aria-label="Program izdanja">
			<h2>Program izdanja <span>{String(posts.length).padStart(2, '0')}</span></h2>
			<ol>
				{issues.map(({ post }, index) => (
					<li>
						<a href={`#release-${post.id}`} data-issue={`release-${post.id}`}>
							<span>{post.data.versionNumber}{index === 0 && <span class="rail-new">Novo</span>}</span>
							<span class="rail-date">{shortDate(post.data.date)}</span>
						</a>
					</li>
				))}
			</ol>
		</aside>

		<section class="intro" aria-labelledby="page-title">
			<h1 id="page-title">Zabilješke o izdanjima</h1>
			<p class="intro-lead">Šta je novo na platformi, najnovije izdanje prvo.</p>
			<p class="privacy"><ShieldCheck size={16} aria-hidden="true" /><span>Privatnost na prvom mjestu. U zabilješkama dijelimo tehničke nadogradnje i nove mogućnosti platforme, bez podataka korisnika, kompanija, klijenata i posjetilaca.</span></p>
		</section>

		<div class="feed" aria-label="Zabilješke o izdanjima">
			{issues.map(({ post, Content }, index) => (
				<Release id={`release-${post.id}`} version={post.data.versionNumber} date={post.data.date} latest={index === 0} href={`/releases/${post.id}`}>
					<Content />
				</Release>
			))}
		</div>
	</main>
</Layout>

<script>
	// Gdje sam u programu: označi stavku u koloni izdanja čije se izdanje trenutno čita.
	function followIssues() {
		const links = new Map<string, HTMLAnchorElement>();
		document.querySelectorAll<HTMLAnchorElement>('.rail a[data-issue]').forEach((a) => links.set(a.dataset.issue!, a));
		if (!links.size || !('IntersectionObserver' in window)) return;
		const mark = (id: string) => links.forEach((a, key) => (key === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
		mark([...links.keys()][0]);
		const observer = new IntersectionObserver(
			(entries) => entries.forEach((entry) => entry.isIntersecting && mark(entry.target.id)),
			{ rootMargin: '-20% 0px -70% 0px' },
		);
		links.forEach((_, id) => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});
	}
	document.addEventListener('astro:page-load', followIssues);
</script>
