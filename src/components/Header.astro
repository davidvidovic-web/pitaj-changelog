---
import '../styles/global.scss';
---

<header class="masthead">
	<nav aria-label="Glavna navigacija">
		<a class="brand" href="/" aria-label="Pitaj.io Novosti, početna">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" width="30" height="30" aria-hidden="true">
				<rect width="28" height="28" rx="3" class="logo-bg" />
				<path class="logo-p" fill-rule="evenodd" d="M6.1 23V5H15.8 C19.4 5 21.6 7.2 21.6 10.6 C21.6 14 19.4 16.2 15.8 16.2 H11V23H6.1Z M11 9.1V12.2H15.4 C16.6 12.2 17.3 11.6 17.3 10.6 C17.3 9.6 16.6 9.1 15.4 9.1H11Z" />
			</svg>
			<span class="brand-text">Pitaj<span class="brand-dot">.io</span></span>
			<span class="brand-section">Novosti</span>
		</a>
		<div class="links">
			<a href="https://pitaj.io" target="_blank" rel="noopener">Pitaj.io</a>
			<a href="https://app.pitaj.io" target="_blank" rel="noopener">Dashboard</a>
			<a href="https://docs.pitaj.io" target="_blank" rel="noopener">Dokumentacija</a>
		</div>
	</nav>
</header>

<style>
	.brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); line-height: 1; }
	.logo-bg { fill: var(--ink); }
	.logo-p { fill: var(--paper); }
	.brand-text { font-weight: 900; font-size: 21px; letter-spacing: -0.02em; }
	.brand-dot { color: var(--blue); }
	.brand-section { margin-left: 4px; padding-left: 12px; border-left: 1px solid var(--hair); font-weight: 500; font-size: 15px; font-stretch: 85%; color: var(--muted); }
</style>
