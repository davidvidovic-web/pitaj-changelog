---
import { 
  ShoppingBag, 
  Smartphone, 
  Globe, 
  Palette, 
  Bot, 
  Workflow, 
  Share2, 
  MessageSquare, 
  Zap, 
  BookOpen, 
  Server, 
  Ticket, 
  Star, 
  Brain, 
  Building2, 
  Sparkles, 
  ShieldCheck,
  CheckCircle2,
  Plug,
  RefreshCw,
  Blocks,
  Code,
  ChartBar
} from '@lucide/astro';

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<div class="feature-heading">
  <span class="icon-badge">
    {icon === 'ecommerce' && <ShoppingBag size={17} />}
    {icon === 'mobile' && <Smartphone size={17} />}
    {icon === 'globe' && <Globe size={17} />}
    {icon === 'palette' && <Palette size={17} />}
    {icon === 'bot' && <Bot size={17} />}
    {icon === 'crawler' && <Workflow size={17} />}
    {icon === 'wordpress' && <Plug size={17} />}
    {icon === 'chat' && <MessageSquare size={17} />}
    {icon === 'sync' && <RefreshCw size={17} />}
    {icon === 'omnichannel' && <Share2 size={17} />}
    {icon === 'cdn' && <Zap size={17} />}
    {icon === 'docs' && <BookOpen size={17} />}
    {icon === 'infra' && <Server size={17} />}
    {icon === 'tickets' && <Ticket size={17} />}
    {icon === 'star' && <Star size={17} />}
    {icon === 'brain' && <Brain size={17} />}
    {icon === 'building' && <Building2 size={17} />}
    {icon === 'widget' && <Blocks size={17} />}
    {icon === 'code' && <Code size={17} />}
    {icon === 'analytics' && <ChartBar size={17} />}
    {!icon && <Sparkles size={17} />}
  </span>
  <h3 class="feature-title">{title}</h3>
</div>

<style>
  .feature-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 1.7em 0 0.8em 0;
  }
  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    flex-shrink: 0;
  }
  .feature-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  @media (prefers-color-scheme: dark) {
    .icon-badge {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.12);
      color: #f8fafc;
    }
  }
</style>
