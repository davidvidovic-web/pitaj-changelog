---
import { 
  ShoppingBag, 
  Smartphone, 
  Globe, 
  Palette, 
  Bot, 
  Workflow, 
  Share2, 
  MessageSquare, 
  Zap, 
  BookOpen, 
  Server, 
  Ticket, 
  Star, 
  Brain, 
  Building2, 
  Sparkles, 
  ShieldCheck,
  CheckCircle2,
  Plug,
  RefreshCw,
  Blocks,
  Code,
  ChartBar
} from '@lucide/astro';

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;

// Oblik pločice je oznaka sama po sebi (krug za razgovor, kvadrat za ostalo); boja samo pojačava.
const circle = ['chat', 'bot', 'omnichannel', 'tickets', 'brain'];
const green = ['infra', 'privacy'];
const ink = ['crawler', 'sync', 'cdn', 'code', 'docs', 'wordpress', 'building'];
const shape = icon && circle.includes(icon) ? 'circle' : 'square';
const tone = icon && green.includes(icon) ? 'green' : icon && ink.includes(icon) ? 'ink' : 'blue';
---
<div class="feature-heading">
	<div class="tile-cell">
		<span class="tile" data-shape={shape} data-tone={tone} aria-hidden="true">
			{icon === 'ecommerce' && <ShoppingBag size={22} strokeWidth={2} />}
			{icon === 'mobile' && <Smartphone size={22} strokeWidth={2} />}
			{icon === 'globe' && <Globe size={22} strokeWidth={2} />}
			{icon === 'palette' && <Palette size={22} strokeWidth={2} />}
			{icon === 'bot' && <Bot size={22} strokeWidth={2} />}
			{icon === 'crawler' && <Workflow size={22} strokeWidth={2} />}
			{icon === 'wordpress' && <Plug size={22} strokeWidth={2} />}
			{icon === 'chat' && <MessageSquare size={22} strokeWidth={2} />}
			{icon === 'sync' && <RefreshCw size={22} strokeWidth={2} />}
			{icon === 'omnichannel' && <Share2 size={22} strokeWidth={2} />}
			{icon === 'cdn' && <Zap size={22} strokeWidth={2} />}
			{icon === 'docs' && <BookOpen size={22} strokeWidth={2} />}
			{icon === 'infra' && <Server size={22} strokeWidth={2} />}
			{icon === 'tickets' && <Ticket size={22} strokeWidth={2} />}
			{icon === 'star' && <Star size={22} strokeWidth={2} />}
			{icon === 'brain' && <Brain size={22} strokeWidth={2} />}
			{icon === 'building' && <Building2 size={22} strokeWidth={2} />}
			{icon === 'widget' && <Blocks size={22} strokeWidth={2} />}
			{icon === 'code' && <Code size={22} strokeWidth={2} />}
			{icon === 'privacy' && <ShieldCheck size={22} strokeWidth={2} />}
			{icon === 'analytics' && <ChartBar size={22} strokeWidth={2} />}
			{!icon && <Sparkles size={22} strokeWidth={2} />}
		</span>
	</div>
	<h3 class="feature-title">{title}</h3>
</div>

<style>
	.feature-heading { display: contents; }
	.tile-cell { grid-column: 1; padding: 22px 0 28px; border-top: 1px solid var(--hair); }
	.feature-title { grid-column: 2; margin: 0; padding: 22px 28px 28px 0; border-top: 1px solid var(--hair); color: var(--ink); font: 700 19px/1.25 var(--sans); letter-spacing: -0.01em; }
	.tile { display: grid; place-items: center; width: 44px; height: 44px; color: var(--on-tile); }
	.tile[data-shape='circle'] { border-radius: 50%; }
	.tile[data-tone='blue'] { background: var(--blue); }
	.tile[data-tone='ink'] { background: var(--ink); color: var(--paper); }
	.tile[data-tone='green'] { background: var(--green); }
	@media (max-width: 960px) {
		.tile-cell { padding: 20px 0 12px; }
		.feature-title { display: flex; align-items: center; min-height: 76px; padding: 20px 0 12px; }
	}
</style>
