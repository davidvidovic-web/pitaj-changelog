---
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = { release: CollectionEntry<'releases'> };
const { release } = Astro.props;
---
<!doctype html>
<html lang="bs">
	<head><BaseHead title={release.data.title} description={release.data.description} image={release.data.image} og={{ type: 'article' }} /></head>
	<body>
		<a class="skip-link" href="#main-content">Preskoči na sadržaj</a>
		<Header />
		<main id="main-content" class="detail-page">
			<h1 class="sr-only">{release.data.title}</h1>
			<a class="back-link" href="/"><ArrowLeft size={16} aria-hidden="true" /> Sva izdanja</a>
			<article class="post single">
				<div class="release-meta"><div class="release-meta-left"><span class="version_number">{release.data.versionNumber}</span><FormattedDate class="date" date={release.data.date} /></div></div>
				<div class="content"><slot /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>
